rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (The catch-all default-deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Profiles collection rules
    match /profiles/{username} {
      // Allowing public reads so volunteer profile pictures are visible when listing/rendering profiles or ID cards.
      allow read: if true;

      // Restricting writes only to users matching the identity schema. Since our app uses Supabase Auth,
      // we match the profile data structure and ensure validation criteria.
      allow create: if isValidProfile(request.resource.data) && username == request.resource.data.username;
      allow update: if isValidProfile(request.resource.data) && username == request.resource.data.username
                    && (incoming().diff(existing()).affectedKeys().hasOnly(['avatar_url', 'updatedAt', 'username']));
      allow delete: if false;
    }

    // 3. Gallery collection rules
    match /gallery/{itemId} {
      // Allow public reads to see community activities.
      allow read: if true;
      allow create, update: if isSignedIn() && isValidGalleryItem(request.resource.data);
      allow delete: if isSignedIn();
    }

    // 4. Website layout/leadership customization settings rules
    match /website_config/{configId} {
      // Allow public reads for display, and updates for administrative setups
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 4.5 Quizzes and Quiz Attempts
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 4.6 Drug reports matching anonymous submissions
    match /drug_reports/{reportId} {
      allow create: if isValidDrugReport(request.resource.data) && reportId == request.resource.data.id;
      allow read, update, delete: if isSignedIn();
    }

    // 4.7 Login logs for persistent and accessible statistics
    match /login_logs/{logId} {
      allow create: if isValidLoginLog(request.resource.data);
      allow read, delete: if isSignedIn();
    }

    // 4.8 NSS Service Clearances (Volunteers' recommended checklists for principal)
    match /nss_service_clearances/{volunteerId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidServiceClearance(request.resource.data);
      allow delete: if false;
    }

    // 4.9 NSS Sealed Certificates (Sealed & approved certificates signed by principal)
    match /nss_sealed_certificates/{volunteerId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidSealedCertificate(request.resource.data);
      allow delete: if false;
    }

    // 5. Connectivity verification check rules
    match /test_connectivity_check/{docId} {
      allow read, write: if true;
    }

    // Reuseable, hardened helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProfile(data) {
      return data.username is string 
        && data.username.size() >= 1 
        && data.username.size() <= 100
        && data.avatar_url is string 
        && data.avatar_url.size() >= 5 
        && data.avatar_url.size() <= 1000000
        && data.updatedAt is string 
        && data.updatedAt.size() <= 100;
    }

    function isValidGalleryItem(data) {
      return data.url is string 
        && data.url.size() >= 5 
        && data.url.size() <= 1000000
        && data.title is string 
        && data.title.size() >= 1 
        && data.title.size() <= 1000
        && data.date is string 
        && data.date.size() <= 100
        && data.category is string 
        && data.category.size() <= 100
        && data.created_at is string 
        && data.created_at.size() <= 100;
    }

    function isValidDrugReport(data) {
      return data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 100
        && data.type is string
        && data.location is string
        && data.details is string
        && data.timeline is string;
    }

    function isValidLoginLog(data) {
      return data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.username is string
        && data.username.size() >= 1
        && data.username.size() <= 128
        && data.name is string
        && data.name.size() <= 128
        && data.role is string
        && data.role.size() <= 128
        && data.mobile is string
        && data.mobile.size() <= 128
        && data.ip is string
        && data.ip.size() <= 128
        && data.userAgent is string
        && data.userAgent.size() <= 1024
        && data.timestamp is string
        && data.timestamp.size() <= 128;
    }

    function isValidServiceClearance(data) {
      return data.name is string 
        && data.name.size() <= 200
        && data.unit is string 
        && data.unit.size() <= 20
        && data.campCompleted is bool
        && data.hoursVerified is bool
        && data.recommendedToPrincipal is bool;
    }

    function isValidSealedCertificate(data) {
      return data.volunteerId is string 
        && data.volunteerId.size() <= 128
        && data.signedAt is string 
        && data.signedAt.size() <= 100
        && data.citation is string 
        && data.citation.size() <= 15000
        && data.sealApproved is bool
        && data.certificateId is string 
        && data.certificateId.size() <= 128;
    }
  }
}
