rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (The catch-all default-deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Profiles collection rules
    match /profiles/{username} {
      // Allowing public reads so volunteer profile pictures are visible when listing/rendering profiles or ID cards.
      allow read: if true;

      // Restricting writes only to users matching the identity schema. Since our app uses Supabase Auth,
      // we match the profile data structure and ensure validation criteria.
      allow create: if isValidProfile(request.resource.data) && username == request.resource.data.username;
      allow update: if isValidProfile(request.resource.data) && username == request.resource.data.username
                    && (incoming().diff(existing()).affectedKeys().hasOnly(['avatar_url', 'updatedAt', 'username']));
      allow delete: if false;
    }

    // 3. Gallery collection rules
    match /gallery/{itemId} {
      // Allow public reads to see community activities.
      allow read: if true;
      allow create, update: if isValidGalleryItem(request.resource.data);
      allow delete: if true;
    }

    // Reuseable, hardened helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProfile(data) {
      return data.username is string 
        && data.username.size() >= 1 
        && data.username.size() <= 100
        && data.avatar_url is string 
        && data.avatar_url.size() >= 5 
        && data.avatar_url.size() <= 1000000
        && data.updatedAt is string 
        && data.updatedAt.size() <= 100;
    }

    function isValidGalleryItem(data) {
      return data.url is string 
        && data.url.size() >= 5 
        && data.url.size() <= 1000000
        && data.title is string 
        && data.title.size() >= 1 
        && data.title.size() <= 1000
        && data.date is string 
        && data.date.size() <= 100
        && data.category is string 
        && data.category.size() <= 100
        && data.created_at is string 
        && data.created_at.size() <= 100;
    }
  }
}
